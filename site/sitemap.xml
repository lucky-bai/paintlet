<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap for the Paintlet landing page.

  Submit it once in Google Search Console (and Bing Webmaster Tools) as
  https://paintlet.app/sitemap.xml. robots.txt in this folder also points at
  it, so crawlers that never see the Search Console submission can still find
  it from the domain root.

  Keep lastmod honest: update it when a page's content changes, not on every
  deploy. A sitemap that claims everything changed yesterday is discounted.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://paintlet.app/</loc>
    <lastmod>2026-08-30</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://paintlet.app/privacy.html</loc>
    <lastmod>2026-08-30</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
